---
import PageLayout from '~/layouts/PageLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('maps', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const metadata = { title: entry.data.title, description: entry.data.description };
const areaTags = entry.data.tags ?? [];
const isPeopleMap = entry.id === 'people';
const [logs, notes, articles, tools, people] = await Promise.all([
  getCollection('log', ({ data }) => !data.draft && Boolean(data.tags?.some((tag) => areaTags.includes(tag)))),
  getCollection('notes', ({ data }) => !data.draft && Boolean(data.tags?.some((tag) => areaTags.includes(tag)))),
  getCollection('articles', ({ data }) => !data.draft && Boolean(data.tags?.some((tag) => areaTags.includes(tag)))),
  getCollection('tools', ({ data }) => !data.draft && Boolean(data.tags?.some((tag) => areaTags.includes(tag)))),
  getCollection('people', ({ data }) => !data.draft),
]);
const peopleById = new Map(people.map((person) => [person.id, person]));
const peopleWithMentions = people
  .sort((left, right) => left.data.title.localeCompare(right.data.title))
  .map((person) => ({
    person,
    mentions: [
      ...logs
        .filter((related) => related.data.people?.includes(person.id))
        .map((related) => ({ entry: related, path: 'log' })),
      ...notes
        .filter((related) => related.data.people?.includes(person.id))
        .map((related) => ({ entry: related, path: 'notes' })),
      ...articles
        .filter((related) => related.data.people?.includes(person.id))
        .map((related) => ({ entry: related, path: 'articles' })),
    ],
  }));
const sections = [
  { label: 'Log', entries: logs, path: 'log' },
  { label: 'Notes', entries: notes, path: 'notes' },
  { label: 'Articles', entries: articles, path: 'articles' },
  { label: 'Tools', entries: tools, path: 'tools' },
];
---

<PageLayout metadata={metadata}>
  <article class="mx-auto max-w-3xl px-6 py-16 sm:py-24 lg:px-8">
    <a class="text-sm font-semibold text-primary hover:underline" href="/maps">&larr; Back to maps</a>
    <h1 class="mt-10 text-4xl font-bold font-heading sm:text-5xl">{entry.data.title}</h1>
    {entry.data.description && <p class="mt-6 text-xl leading-relaxed text-muted">{entry.data.description}</p>}
    <div class="prose prose-lg mt-10 max-w-none dark:prose-invert"><Content /></div>
    {
      isPeopleMap ? (
        <section class="mt-12 border-t border-slate-200 pt-8 dark:border-slate-700" aria-labelledby="people">
          <h2 id="people" class="text-2xl font-bold font-heading">
            People
          </h2>
          {peopleWithMentions.length ? (
            <div class="mt-8 space-y-12">
              {peopleWithMentions.map(({ person, mentions }) => (
                <article id={person.id} class="scroll-mt-8">
                  <h3 class="text-xl font-bold font-heading">{person.data.title}</h3>
                  <p class="mt-3 leading-relaxed text-muted">{person.data.description}</p>
                  <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
                    {person.data.homepage && (
                      <a
                        class="font-semibold text-primary hover:underline"
                        href={person.data.homepage}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Homepage
                      </a>
                    )}
                    {person.data.links?.map((link) => (
                      <a
                        class="font-semibold text-primary hover:underline"
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {link.title}
                      </a>
                    ))}
                  </div>
                  {person.data.relatedPeople?.length && (
                    <div class="mt-6">
                      <h4 class="font-semibold">Connections</h4>
                      <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
                        {person.data.relatedPeople.map((relatedPersonId) => {
                          const relatedPerson = peopleById.get(relatedPersonId);
                          return relatedPerson ? (
                            <li>
                              <a class="text-primary hover:underline" href={`#${relatedPerson.id}`}>
                                {relatedPerson.data.title}
                              </a>
                            </li>
                          ) : null;
                        })}
                      </ul>
                    </div>
                  )}
                  <div class="mt-6">
                    <h4 class="font-semibold">Mentioned in</h4>
                    {mentions.length ? (
                      <ul class="mt-2 space-y-2">
                        {mentions.map((mention) => (
                          <li>
                            <a class="text-primary hover:underline" href={`/${mention.path}/${mention.entry.id}`}>
                              {mention.entry.data.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="mt-2 text-muted">No garden entries mention this person yet.</p>
                    )}
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="mt-4 text-muted">No people have been added yet.</p>
          )}
        </section>
      ) : (
        <div class="mt-12 grid gap-8 border-t border-slate-200 pt-8 dark:border-slate-700 md:grid-cols-2">
          {sections.map((section) => (
            <section>
              <h2 class="text-xl font-bold font-heading">{section.label}</h2>
              <ul class="mt-3 space-y-2">
                {section.entries.length ? (
                  section.entries.map((related) => (
                    <li>
                      <a class="text-primary hover:underline" href={`/${section.path}/${related.id}`}>
                        {related.data.title}
                      </a>
                    </li>
                  ))
                ) : (
                  <li class="text-muted">No entries tagged {areaTags.join(', ')} yet.</li>
                )}
              </ul>
            </section>
          ))}
        </div>
      )
    }
    {
      entry.data.links?.length && (
        <footer class="mt-12 border-t border-slate-200 pt-6 dark:border-slate-700">
          <p class="font-semibold">Follow the links</p>
          <ul class="mt-3 space-y-2">
            {entry.data.links.map((link) => (
              <li>
                <a class="text-primary hover:underline" href={link}>
                  {link}
                </a>
              </li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>
</PageLayout>
