---
import PageLayout from '~/layouts/PageLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('maps', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const metadata = { title: entry.data.title, description: entry.data.description };
const areaTags = entry.data.tags ?? [];
const [logs, notes, articles] = await Promise.all([
  getCollection('log', ({ data }) => !data.draft && Boolean(data.tags?.some((tag) => areaTags.includes(tag)))),
  getCollection('notes', ({ data }) => !data.draft && Boolean(data.tags?.some((tag) => areaTags.includes(tag)))),
  getCollection('articles', ({ data }) => !data.draft && Boolean(data.tags?.some((tag) => areaTags.includes(tag)))),
]);
const sections = [
  { label: 'Log', entries: logs, path: 'log' },
  { label: 'Notes', entries: notes, path: 'notes' },
  { label: 'Articles', entries: articles, path: 'articles' },
];
---

<PageLayout metadata={metadata}>
  <article class="mx-auto max-w-3xl px-6 py-16 sm:py-24 lg:px-8">
    <a class="text-sm font-semibold text-primary hover:underline" href="/maps">&larr; Back to maps</a>
    <h1 class="mt-10 text-4xl font-bold font-heading sm:text-5xl">{entry.data.title}</h1>
    {entry.data.description && <p class="mt-6 text-xl leading-relaxed text-muted">{entry.data.description}</p>}
    <div class="prose prose-lg mt-10 max-w-none dark:prose-invert"><Content /></div>
    <div class="mt-12 grid gap-8 border-t border-slate-200 pt-8 dark:border-slate-700 md:grid-cols-3">
      {
        sections.map((section) => (
          <section>
            <h2 class="text-xl font-bold font-heading">{section.label}</h2>
            <ul class="mt-3 space-y-2">
              {section.entries.length ? (
                section.entries.map((related) => (
                  <li>
                    <a class="text-primary hover:underline" href={`/${section.path}/${related.id}`}>
                      {related.data.title}
                    </a>
                  </li>
                ))
              ) : (
                <li class="text-muted">No entries tagged {areaTags.join(', ')} yet.</li>
              )}
            </ul>
          </section>
        ))
      }
    </div>
    {
      entry.data.links?.length && (
        <footer class="mt-12 border-t border-slate-200 pt-6 dark:border-slate-700">
          <p class="font-semibold">Follow the links</p>
          <ul class="mt-3 space-y-2">
            {entry.data.links.map((link) => (
              <li>
                <a class="text-primary hover:underline" href={link}>
                  {link}
                </a>
              </li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>
</PageLayout>
