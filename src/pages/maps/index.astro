---
import PageLayout from '~/layouts/PageLayout.astro';
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('maps', ({ data }) => !data.draft)).sort(
  (left, right) => (right.data.publishDate?.valueOf() ?? 0) - (left.data.publishDate?.valueOf() ?? 0)
);
const renderedEntries = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
const metadata = { title: 'Maps', description: 'Indexes that connect related ideas and paths through mikes.blog.' };
---

<PageLayout metadata={metadata}>
  <section class="mx-auto max-w-4xl px-6 py-16 sm:py-24 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Collection / Maps</p>
    <h1 class="mt-4 text-5xl font-bold font-heading">Find your way around.</h1>
    <p class="mt-6 max-w-2xl text-xl leading-relaxed text-muted">
      Topic indexes and link collections that make the relationships between ideas easier to see.
    </p>
    <div class="mt-14 divide-y divide-slate-200 dark:divide-slate-700">
      {
        renderedEntries.map(({ entry, Content }) => (
          <article class="py-8 first:pt-0 last:pb-0">
            <h2 class="text-2xl font-bold font-heading">
              <a class="hover:text-primary" href={`/maps/${entry.id}`}>
                {entry.data.title}
              </a>
            </h2>
            {entry.data.description && <p class="mt-3 text-lg leading-relaxed text-muted">{entry.data.description}</p>}
            <div class="prose prose-lg mt-4 max-w-none dark:prose-invert">
              <Content />
            </div>
            <a class="mt-4 inline-block font-semibold text-primary hover:underline" href={`/maps/${entry.id}`}>
              Open map &rarr;
            </a>
          </article>
        ))
      }
    </div>
  </section>
</PageLayout>
