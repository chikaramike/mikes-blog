---
import PageLayout from '~/layouts/PageLayout.astro';
---

<PageLayout metadata={{ title: 'Page not found', ignoreTitleTemplate: true }}>
  <section class="mx-auto max-w-3xl px-6 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">404</p>
    <h1 class="mt-4 text-4xl font-bold font-heading">That page is not here.</h1>
    <p class="mt-4 text-lg text-muted">The garden may have moved the idea somewhere else.</p>
    <a class="mt-8 inline-block font-semibold text-primary hover:underline" href="/">Return home &rarr;</a>
  </section>
</PageLayout>
