---
import { getCollection, render } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('tools', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const destinationUrl = entry.data.affiliateUrl ?? entry.data.website;
const metadata = { title: entry.data.title, description: entry.data.description };
---

<PageLayout metadata={metadata}>
  <article class="mx-auto max-w-3xl px-6 py-16 sm:py-24 lg:px-8">
    <a class="text-sm font-semibold text-primary hover:underline" href="/tools">&larr; Back to tools</a>
    <p class="mt-10 text-sm font-semibold uppercase tracking-[0.2em] text-primary">{entry.data.category}</p>
    <h1 class="mt-4 text-4xl font-bold font-heading sm:text-5xl">{entry.data.title}</h1>
    <p class="mt-6 text-xl leading-relaxed text-muted">{entry.data.description}</p>
    <a
      class="mt-8 inline-block bg-primary px-5 py-3 font-semibold text-white hover:opacity-90"
      href={destinationUrl}
      target="_blank"
      rel="noopener noreferrer sponsored"
    >
      {entry.data.actionLabel ?? `Visit ${entry.data.title}`}
    </a>
    {
      entry.data.affiliateUrl && (
        <p class="mt-3 text-sm leading-relaxed text-muted">
          This is an affiliate link. I may earn a commission if you use it, at no additional cost to you. Thanks for
          supporting my work.
        </p>
      )
    }
    <div class="prose prose-lg mt-12 max-w-none dark:prose-invert"><Content /></div>
    {
      entry.data.resources?.length && (
        <section class="mt-12 border-t border-slate-200 pt-8 dark:border-slate-700" aria-labelledby="resources">
          <h2 id="resources" class="text-2xl font-bold font-heading">
            Useful links
          </h2>
          <ul class="mt-5 space-y-4">
            {entry.data.resources.map((resource) => (
              <li>
                <span class="mr-2 text-sm text-muted">{resource.type}</span>
                <a
                  class="font-semibold text-primary hover:underline"
                  href={resource.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {resource.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</PageLayout>
