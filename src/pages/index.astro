---
import PageLayout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { SITE, I18N } from 'astrowind:config';

const metadata = {
  title: 'A web log for ideas in motion',
  ignoreTitleTemplate: true,
  description: 'mikes.blog is a personal digital garden about leadership, technology, operations, and change.',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE?.name,
  url: SITE?.site,
  inLanguage: I18N?.language,
  description: metadata.description,
};

const collections = [
  {
    href: '/log',
    label: 'Log',
    icon: 'tabler:history',
    chipClass: 'bg-blue-500/10 text-blue-500 dark:bg-blue-400/15 dark:text-blue-300',
    description: 'Short observations, decisions, and working signals.',
  },
  {
    href: '/notes',
    label: 'Notes',
    icon: 'tabler:notebook',
    chipClass: 'bg-indigo-500/10 text-indigo-500 dark:bg-indigo-400/15 dark:text-indigo-300',
    description: 'Ideas I am developing, testing, and returning to.',
  },
  {
    href: '/articles',
    label: 'Articles',
    icon: 'tabler:article',
    chipClass: 'bg-violet-500/10 text-violet-500 dark:bg-violet-400/15 dark:text-violet-300',
    description: 'Longer arguments built from the work underneath.',
  },
  {
    href: '/maps',
    label: 'Maps',
    icon: 'tabler:map-2',
    chipClass: 'bg-slate-500/10 text-slate-500 dark:bg-slate-400/15 dark:text-slate-300',
    description: 'Indexes that connect related ideas and paths.',
  },
];
---

<PageLayout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>
  <section class="mx-auto max-w-5xl px-6 py-20 sm:py-28 lg:px-8">
    <p class="mb-6 text-sm font-semibold uppercase tracking-[0.2em] text-primary">mikes.blog</p>
    <h1 class="max-w-4xl text-5xl font-bold leading-tight tracking-tight font-heading sm:text-6xl lg:text-7xl">
      A web log for ideas in motion.
    </h1>
    <p class="mt-8 max-w-2xl text-xl leading-relaxed text-muted sm:text-2xl">
      I'm Mike. I'm interested in digital transformation, operational improvement, and the human systems that make both
      possible.
    </p>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
      This is where I keep the thoughts, notes, arguments, and connections that are still becoming clear.
    </p>
    <div class="mt-12 flex flex-wrap gap-4">
      {
        collections.map((collection) => (
          <a
            class="rounded border border-current px-5 py-3 font-semibold transition hover:bg-primary hover:text-white"
            href={collection.href}
          >
            {collection.label}
          </a>
        ))
      }
    </div>
  </section>

  <section class="border-y border-slate-200 dark:border-slate-700">
    <div class="mx-auto grid max-w-5xl gap-px bg-slate-200 dark:bg-slate-700 sm:grid-cols-2 lg:grid-cols-4">
      {
        collections.map((collection) => (
          <a class="bg-page p-6 transition hover:bg-slate-50 dark:hover:bg-slate-900" href={collection.href}>
            <span class={`inline-flex h-11 w-11 items-center justify-center rounded-xl ${collection.chipClass}`}>
              <Icon name={collection.icon} class="h-6 w-6" aria-hidden="true" />
            </span>
            <h2 class="mt-4 text-xl font-bold font-heading">{collection.label}</h2>
            <p class="mt-3 text-muted">{collection.description}</p>
            <span class="mt-6 inline-block text-sm font-semibold text-primary">
              Explore {collection.label.toLowerCase()} &rarr;
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-20 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">The point</p>
      <h2 class="mt-4 text-3xl font-bold font-heading sm:text-4xl">
        Thinking in public, one useful connection at a time.
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-muted">
        Good transformation work is rarely just about selecting a tool. It is about making priorities visible, improving
        the way work moves, and helping people make better decisions together. This garden is a place to practice that
        thinking.
      </p>
    </div>
  </section>
</PageLayout>
