---
import PageLayout from '~/layouts/PageLayout.astro';
import { getCollection, render } from 'astro:content';
import Image from '~/components/common/Image.astro';

const entries = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (left, right) => (right.data.publishDate?.valueOf() ?? 0) - (left.data.publishDate?.valueOf() ?? 0)
);
const renderedEntries = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
const metadata = { title: 'Articles', description: 'Longer arguments and explanations from Mike.' };
---

<PageLayout metadata={metadata}>
  <section class="mx-auto max-w-4xl px-6 py-16 sm:py-24 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Collection / Articles</p>
    <h1 class="mt-4 text-5xl font-bold font-heading">The longer view.</h1>
    <p class="mt-6 max-w-2xl text-xl leading-relaxed text-muted">
      More considered arguments built from the logs, notes, and experience underneath them.
    </p>
    <div class="mt-14 divide-y divide-slate-200 dark:divide-slate-700">
      {
        renderedEntries.map(({ entry, Content }) => (
          <article class="py-8 first:pt-0 last:pb-0">
            {entry.data.image && (
              <Image
                src={entry.data.image}
                width={900}
                height={506}
                class="mb-6 aspect-video w-full rounded object-cover"
                alt={entry.data.imageAlt || entry.data.title}
                loading="lazy"
              />
            )}
            <p class="text-sm text-muted">
              {entry.data.publishDate?.toLocaleDateString('en-US', { dateStyle: 'long' })}
            </p>
            <h2 class="mt-2 text-2xl font-bold font-heading">
              <a class="hover:text-primary" href={`/articles/${entry.id}`}>
                {entry.data.title}
              </a>
            </h2>
            {entry.data.excerpt && <p class="mt-3 text-lg leading-relaxed text-muted">{entry.data.excerpt}</p>}
            <div class="prose prose-lg mt-4 max-w-none dark:prose-invert">
              <Content />
            </div>
            <a class="mt-4 inline-block font-semibold text-primary hover:underline" href={`/articles/${entry.id}`}>
              Read article &rarr;
            </a>
          </article>
        ))
      }
    </div>
  </section>
</PageLayout>
